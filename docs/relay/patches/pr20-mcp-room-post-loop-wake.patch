index 513803e..12ffe97 100644
--- a/lib/hq/dispatch-guard.js
+++ b/lib/hq/dispatch-guard.js
@@ -19,3 +19,9 @@ export function dispatchReplyError(dispatch, { seatId, expectedAttempt = null, n
   }
   return null;
 }
+
+// A stored first reply to a dispatch may be what an execution-loop task is waiting on.
+// Rejected (stale, expired, wrong-seat, terminal) and replayed replies wake nothing.
+export function replyWakesLoop(saved, dispatchId) {
+  return Boolean(dispatchId) && Boolean(saved?.message) && !saved.error && !saved.deduped;
+}
