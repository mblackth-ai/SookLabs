# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
sooklabs.env.local
.env.vercel.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archives and temp extraction (not for version control)
*.zip
_tmp_*/

.vercel
# n8n provision run artifacts (local only)
docs/n8n/hq-provision-result.json

# HQ room transcript when Postgres is not configured (local only)
/data/hq/room.json
/data/hq/room.json.tmp
/data/hq/swarm.json
/data/hq/swarm.json.tmp

# HQ room seat connections generated by scripts/hq-room-seats.mjs (local only)
.hq-room-seats.local.env
# Self-enrolled seat keys written by scripts/hq-seat-enroll.mjs (local only)
.hq-seat-*.env
