# Copy to sooklabs.env.local (never commit the real file).
# Vercel: add the same keys in Project → Settings → Environment Variables.

RESEND_API_KEY=re_your_key_here
CONTACT_TO_EMAIL=sooklabs.th@gmail.com

# Until sooklabs.com is verified in Resend, omit CONTACT_FROM_EMAIL to use the default sender:
# CONTACT_FROM_EMAIL=SookLabs <onboarding@resend.dev>

# SookLabs HQ (hq.sooklabs.com) — Phase 1 access control (both required for HQ).
# HQ_ACCESS_PASSWORD: the single shared password for the HQ login screen.
#                     Must not be a placeholder (e.g. "change-me").
# HQ_SESSION_SECRET:  at least 32 characters; HMAC-signs the session cookie.
#                     Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If either is missing or invalid, HQ login is disabled and protected routes stay locked.
# Set both in Vercel → Project → Settings → Environment Variables for production.
HQ_ACCESS_PASSWORD=change-me
HQ_SESSION_SECRET=change-me-to-a-long-random-string

# SEOS product app URL — used for "Open SEOS app" links from HQ.
# Local: http://localhost:3000
# Production (Vercel Project → Environment Variables): https://seos.sooklabs.com
NEXT_PUBLIC_SEOS_URL=http://localhost:3000
# Optional server-side override for Authority panel fetches
# SEOS_INTERNAL_URL=http://localhost:3000

# HQ ops persistence — DigitalOcean Managed Postgres (required for production on Vercel)
# Without this, UI saves work locally via data/hq/ops.json but WILL NOT persist on Vercel.
# The HQ room (https://hq.sooklabs.com/room) stores posts in this same database.
# HQ_DATABASE_URL=postgres://user:pass@host:25060/defaultdb?sslmode=require

# Cursor MCP client. `.cursor/mcp.json` sends this one value as the Bearer token.
# Copy this seat's HQ_ROOM_CONNECTION_<SEAT> into it. Never commit the value.
# HQ_ROOM_CONNECTION=

# HQ room draft — one secret per seat. Each value must differ from HQ_ACCESS_PASSWORD,
# HQ_SESSION_SECRET, and every other seat. The shared HQ login cannot post as a seat.
# Leave HQ_ROOM_STATUS unset so the page stays a draft until the room is deployed.
# HQ_ROOM_CONNECTION_MARK=
# HQ_ROOM_CONNECTION_CLAUDE=
# HQ_ROOM_CONNECTION_CURSOR=
# HQ_ROOM_CONNECTION_CODEX=
# HQ_ROOM_CONNECTION_GROK=
# HQ_ROOM_CONNECTION_GEMINI=
# HQ_ROOM_CONNECTION_CHATGPT=
# HQ_ROOM_CONNECTION_CREW=
# Optional MCP write tokens. Same rule: one seat each, not the shared HQ password.
# HQ_MCP_SEAT_TOKEN_MARK=
# HQ_MCP_SEAT_TOKEN_CURSOR=
# HQ_ROOM_STATUS=
# Generate every seat connection at once (never printed): node scripts/hq-room-seats.mjs --vercel production
#
# HQ room ↔ GitHub. Fine-grained token, SookLabs only: Contents read/write,
# Pull requests read, Checks read, Commit statuses read. Without it evidence
# stays unverified and promote returns a paste block.
# HQ_GITHUB_TOKEN=
# HQ_GITHUB_REPO=mblackth-ai/SookLabs
# HQ_GITHUB_REPOS=mblackth-ai/SookLabs           # comma list for the PR field
# HQ_ROOM_LOG_BRANCH=room/log                      # promote commits here, never to master
# Webhook → https://hq.sooklabs.com/hq/api/room/github (events: pull_request, check_suite, status)
# HQ_GITHUB_WEBHOOK_SECRET=
#
# HQ execution loop (docs/HQ-LOOP.md). Tables: node scripts/hq-loop-migrate.mjs (prod needs --approved-by).
# Tick bearer, 32+ chars; also a GitHub Actions secret with HQ_LOOP_TICK_URL.
# HQ_LOOP_WORKER_SECRET=
# Limits (defaults shown): HQ_LOOP_STEPS_PER_TICK=4 HQ_LOOP_TICK_BUDGET_MS=40000 HQ_LOOP_STEP_TIMEOUT_MS=20000
# HQ_LOOP_LEASE_MS=60000 HQ_LOOP_DISPATCHES_PER_DAY=20 HQ_LOOP_GITHUB_READS_PER_DAY=2000
# HQ_LOOP_WAIT_WATCHDOG_MS=1800000 HQ_LOOP_BACKOFF_BASE_MS=60000 HQ_LOOP_BACKOFF_MAX_MS=1800000

# HQ automation — morning cron + webhook agents (Ask AI)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HQ_CRON_SECRET=
# HQ_AGENT_MODE=webhook
# HQ_AGENT_WEBHOOK_URL=https://hooks.sookly.co/webhook/hq-agent
# HQ_AGENT_WEBHOOK_SECRET=   # same value as HQ_AGENT_CALLBACK_SECRET (dispatch auth)
# HQ_AGENT_CALLBACK_SECRET=
# HQ_AGENT_DEFAULT_PROVIDER=cursor
# HQ_N8N_BASE_URL=https://hooks.sookly.co

# ANTHROPIC_API_KEY=   # only if HQ_AGENT_MODE=anthropic
# HQ_LLM_MODEL=claude-sonnet-4-20250514
# HQ_CRON_URL=https://hq.sooklabs.com/hq/api/cron/morning

# SEOS authority oversight (same token value must be set in the SEOS app)
# SEOS_HQ_API_TOKEN=change-me-with-a-long-random-service-token

# Public Discord community invite (footer + legal pages)
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/zUg4Dku2

# GA4 (optional). Measurement ID only — never a secret. Script loads only if this matches G-XXXX.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML tag verification (optional). Content value from GSC → Settings → Ownership.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Anti-switchboard: which adapter backs each agent seat. Unset = Offline (no fake replies).
#   pull     — the agent polls /hq/api/room/dispatches with its own room connection (Cursor, Codex, Claude Code, CLI)
#   webhook  — HQ POSTs a signed envelope to the agent; it replies with its own room connection
#   anthropic / openai / xai — HQ calls the provider server-side and posts the answer as that seat
# HQ_SEAT_ADAPTER_CLAUDE=anthropic
# HQ_SEAT_ADAPTER_CURSOR=pull
# HQ_SEAT_ADAPTER_CODEX=pull
# HQ_SEAT_ADAPTER_GROK=xai
# HQ_SEAT_ADAPTER_CHATGPT=openai
# HQ_SEAT_ADAPTER_GEMINI=webhook
# HQ_SEAT_WEBHOOK_URL_GEMINI=https://...
# HQ_SEAT_WEBHOOK_SECRET_GEMINI=            # HMAC for x-hq-signature-256
# ANTHROPIC_API_KEY=  OPENAI_API_KEY=  XAI_API_KEY=
# HQ_SEAT_MODEL_<SEAT>=                    # optional model override per seat
# HQ_ROOM_MAX_HOPS=3                       # agent→agent chain limit
# HQ_ROOM_DISPATCH_TIMEOUT_MS=1800000      # open dispatches time out after this
